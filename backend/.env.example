APP_NAME=Averlen
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
ENABLE_DOCS=true
LOG_LEVEL=INFO
TESTING=false
SQL_ECHO=false
AUDIT_ALL_REQUESTS=false
DISABLE_AUDIT_LOGS=false

DATABASE_URL=postgresql+psycopg://averlen:averlen@localhost:5433/averlen
REDIS_URL=redis://localhost:6379/0

OPENROUTER_API_KEY=
OPENROUTER_MODEL=stepfun/step-3.5-flash:free
SITE_URL=http://localhost:8000
SITE_NAME=Averlen

MEDIA_STORAGE_BACKEND=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=averlen
MEDIA_UPLOAD_TIMEOUT_SECONDS=15

AI_QUESTION_MAX_CHARS=500
AI_MAX_CONTEXT_CHARS=5000
AI_LLM_TIMEOUT_SECONDS=20
AI_DAILY_USER_LIMIT=50
AI_DAILY_ORG_LIMIT=200

# Public property photos only. Booking CSVs must remain private.
UPLOAD_DIR=uploads
PRIVATE_UPLOAD_DIR=storage/private_uploads/csv
PUBLIC_UPLOAD_DIR=storage/public_uploads/property_photos
PUBLIC_AVATAR_UPLOAD_DIR=storage/public_uploads/user_avatars
MAX_UPLOAD_SIZE_MB=5
MAX_CSV_ROWS=10000
MAX_CSV_COLUMNS=100
CSV_PREVIEW_ROWS=5
UPLOAD_SESSION_EXPIRE_MINUTES=60

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
BCRYPT_ROUNDS=12

REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=averlen_refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_PATH=/api/auth

RATE_LIMIT_ENABLED=true
ADMIN_EMAILS=

TERMS_VERSION=2026-05-13
PRIVACY_VERSION=2026-05-13
INVITE_EXPIRE_HOURS=168

FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
